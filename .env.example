DATABASE_URL="postgresql://awad:awad@localhost:5432/emi_dev?schema=public"

# Shared secret the emi frontend must send as `x-api-key` on every request.
API_KEY="change-me"

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN="http://localhost:3000"

PORT=3001

# Customer auth (Bullseye and future storefronts share this).
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Razorpay (Bullseye checkout + webhook).
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="replace-with-razorpay-test-key-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-a-shared-secret-you-set-in-razorpay-dashboard"

# Admin console (/admin on the portfolio). Separate secret from JWT_SECRET so a
# storefront customer token can never be replayed against an admin endpoint.
ADMIN_JWT_SECRET="replace-with-a-long-random-string"
ADMIN_JWT_EXPIRES_IN="12h"

# Seeded by `npm run prisma:seed` (created once; never overwritten afterwards).
ADMIN_USERNAME="awadali"
ADMIN_PASSWORD="replace-with-the-admin-password"

# Set to "production" on a deployed instance. Turns Swagger off and makes
# CORS_ORIGIN mandatory.
NODE_ENV="development"

# Force Swagger on/off regardless of NODE_ENV. Leave unset for the default
# (on outside production, off in production).
# ENABLE_SWAGGER="false"

# Interface to bind. Set to 127.0.0.1 when nginx (or another reverse proxy)
# fronts this app on a shared server, so the port is not publicly reachable.
# Leave unset (0.0.0.0) inside a container.
# HOST="127.0.0.1"
