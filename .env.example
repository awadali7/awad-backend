DATABASE_URL="postgresql://awad:awad@localhost:5432/emi_dev?schema=public"

# Shared secret the emi frontend must send as `x-api-key` on every request.
API_KEY="change-me"

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN="http://localhost:3000"

PORT=3001

# Customer auth (Bullseye and future storefronts share this).
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Razorpay (Bullseye checkout + webhook).
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="replace-with-razorpay-test-key-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-a-shared-secret-you-set-in-razorpay-dashboard"
