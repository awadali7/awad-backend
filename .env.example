DATABASE_URL="postgresql://awad:awad@localhost:5432/emi_dev?schema=public"

# Shared secret the emi frontend must send as `x-api-key` on every request.
API_KEY="change-me"

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN="http://localhost:3000"

PORT=3001

# Customer auth (Bullseye and future storefronts share this).
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Razorpay (Bullseye checkout + webhook).
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="replace-with-razorpay-test-key-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-a-shared-secret-you-set-in-razorpay-dashboard"

# Admin console (/admin on the portfolio). Separate secret from JWT_SECRET so a
# storefront customer token can never be replayed against an admin endpoint.
ADMIN_JWT_SECRET="replace-with-a-long-random-string"
ADMIN_JWT_EXPIRES_IN="12h"

# Seeded by `npm run prisma:seed` (created once; never overwritten afterwards).
ADMIN_USERNAME="awadali"
ADMIN_PASSWORD="replace-with-the-admin-password"

# Set to "production" on a deployed instance. Turns Swagger off and makes
# CORS_ORIGIN mandatory.
NODE_ENV="development"

# Force Swagger on/off regardless of NODE_ENV. Leave unset for the default
# (on outside production, off in production).
# ENABLE_SWAGGER="false"

# Interface to bind. Set to 127.0.0.1 when nginx (or another reverse proxy)
# fronts this app on a shared server, so the port is not publicly reachable.
# Leave unset (0.0.0.0) inside a container.
# HOST="127.0.0.1"

# Azure OpenAI — powers the Money Manage chat assistant. Leave blank to turn
# the assistant off (the console hides it rather than erroring).
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com/"
AZURE_OPENAI_DEPLOYMENT="gpt-4o-your-deployment"
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_API_VERSION="2025-01-01-preview"

# Optional second operator, seeded the same way as the primary admin. Her money
# records are scoped to her own account; category lists are shared.
SECOND_ADMIN_USERNAME=""
SECOND_ADMIN_PASSWORD=""

# Blog image uploads. Files are saved under UPLOADS_DIR and served at /uploads.
# Point it at a folder outside the code, for example /var/www/awad-uploads, so
# a deploy never deletes uploaded images. Defaults to ./uploads.
# UPLOADS_DIR="/var/www/awad-uploads"
# Public address of that folder. Defaults to this API's own /uploads address.
# UPLOADS_PUBLIC_URL="https://api.awadali.com/uploads"
