// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BillType {
  emi
  chitty
  recurring
  credit_card
}

model Bill {
  id                 String    @id @default(uuid())
  name               String
  category           String
  type               BillType
  amount             Int
  /// Day of month (1-31), clamped to the month's last day. Null = not set.
  dueDay             Int?
  /// Due on the last calendar day of the month (overrides dueDay).
  endOfMonth         Boolean   @default(false)
  installmentsPaid   Int?
  installmentsTotal  Int?
  installmentsLeft   Int?
  /// "YYYY-MM" of the cycle last marked paid.
  lastPaidCycle      String?
  /// "YYYY-MM" of the cycle the "due tomorrow" notification already fired for.
  lastNotifiedCycle  String?
  archived           Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model IncomeSettings {
  /// Single household row, fixed id.
  id           String @id @default("household")
  userSalary   Int
  spouseSalary Int
}

enum OrderStatus {
  created
  paid
  failed
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]
}

model Product {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  description String
  /// Price in paise (smallest INR unit) — Razorpay convention, avoids float rounding.
  priceInPaise Int
  /// Only ever returned once the caller's Order for this product is `paid`.
  downloadUrl String
  imageUrl    String?
  /// Soft-delete flag (mirrors Bill.archived). False = hidden from public listing.
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]
}

model Order {
  id                String      @id @default(uuid())
  userId            String
  productId         String
  /// Snapshot of Product.priceInPaise at purchase time.
  amountInPaise     Int
  status            OrderStatus @default(created)
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?
  razorpaySignature String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}
