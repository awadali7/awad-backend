// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CategoryKind {
  emi
  income
  expense
}

/// A managed vocabulary of category names, edited under Settings.
///
/// Records store their category as a plain string rather than a foreign key:
/// the Bill rows predate this table and already carry free text, and a label
/// typo should never cascade into deleting someone's bill history.
model Category {
  id        String       @id @default(uuid())
  kind      CategoryKind
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([kind, name])
  @@index([kind])
}

/// Money borrowed from a person or lender: a single sum taken on one date and
/// owed back by another. Distinct from Bill, which repeats every month.
model Borrowing {
  id        String    @id @default(uuid())
  /// Who the money came from.
  lender    String
  /// Whole rupees.
  amount    Int
  /// When the money was taken.
  startDate DateTime
  /// When it is owed back.
  dueDate   DateTime
  /// Null while still outstanding; set once settled.
  repaidOn  DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// Owner. Every read and write is filtered by this.
  adminUserId String
  admin       AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([repaidOn, dueDate])
  @@index([adminUserId])
}

/// A one-off cost in a given month (groceries, fuel). Unlike Bill, an expense
/// does not repeat — each one belongs to exactly one "YYYY-MM".
model Expense {
  id        String   @id @default(uuid())
  label     String
  /// Whole rupees.
  amount    Int
  /// "YYYY-MM" this expense counts towards.
  cycle     String
  category  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Owner. Every read and write is filtered by this.
  adminUserId String
  admin       AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([cycle])
  @@index([adminUserId])
}

enum BillType {
  emi
  chitty
  recurring
  credit_card
}

model Bill {
  id                String   @id @default(uuid())
  name              String
  category          String
  type              BillType
  amount            Int
  /// Day of month (1-31), clamped to the month's last day. Null = not set.
  dueDay            Int?
  /// Due on the last calendar day of the month (overrides dueDay).
  endOfMonth        Boolean  @default(false)
  installmentsPaid  Int?
  installmentsTotal Int?
  installmentsLeft  Int?
  /// "YYYY-MM" of the first cycle this is billed in. Null = already running,
  /// which is how every bill created before this field existed behaves.
  startCycle        String?
  /// "YYYY-MM" of the cycle last marked paid.
  lastPaidCycle     String?
  /// "YYYY-MM" of the cycle the "due tomorrow" notification already fired for.
  lastNotifiedCycle String?
  archived          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  /// Owner. Every read and write is filtered by this.
  adminUserId String
  admin       AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

/// A source of household income.
///
/// `cycle` null  -> permanent: counts towards every month (salary, rent received).
/// `cycle` set   -> one-off: counts only towards that "YYYY-MM" (bonus, freelance).
///
/// Same null-means-always convention as Bill.startCycle, so one list covers both
/// kinds without a second table or a type flag.
model IncomeSource {
  id        String   @id @default(uuid())
  label     String
  /// Whole rupees.
  amount    Int
  cycle     String?
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Owner. Every read and write is filtered by this.
  adminUserId String
  admin       AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([cycle])
  @@index([adminUserId])
}

enum OrderStatus {
  created
  paid
  failed
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]
}

model Product {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  description  String
  /// Price in paise (smallest INR unit) — Razorpay convention, avoids float rounding.
  priceInPaise Int
  /// Only ever returned once the caller's Order for this product is `paid`.
  downloadUrl  String
  imageUrl     String?
  /// Soft-delete flag (mirrors Bill.archived). False = hidden from public listing.
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]
}

model Order {
  id                String      @id @default(uuid())
  userId            String
  productId         String
  /// Snapshot of Product.priceInPaise at purchase time.
  amountInPaise     Int
  status            OrderStatus @default(created)
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?
  razorpaySignature String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

/// Operator account for the /admin console on the portfolio. Deliberately
/// separate from `User` (storefront customers): different credential shape
/// (username, not email) and a different token audience.
model AdminUser {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  name         String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /// Each operator's money is entirely their own. Categories are deliberately
  /// NOT here — that vocabulary is shared across the household.
  bills         Bill[]
  incomeSources IncomeSource[]
  expenses      Expense[]
  borrowings    Borrowing[]

  /// Posts this operator wrote. Unlike the money models, the blog is shared:
  /// every admin can edit every post, and this only records authorship.
  blogPosts BlogPost[]
}

enum BlogPostStatus {
  draft
  published
}

/// A section of the public blog, served at /blog/category/<slug>.
///
/// Deliberately not `Category`: that model is the money vocabulary (EMI,
/// income, expense) and the two lists have nothing in common.
model BlogCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  /// URL segment. Changing it changes the category page's address.
  slug        String   @unique
  /// Intro text and meta description for the category page.
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts BlogPost[]
}

/// A post on the public blog at /blog/<slug>. The body is markdown.
model BlogPost {
  id               String         @id @default(uuid())
  /// URL segment. Locked once the post has been published, so links never break.
  slug             String         @unique
  title            String
  /// Card text, and the meta description when seoDescription is empty.
  excerpt          String
  /// Markdown body.
  content          String
  coverImageUrl    String?
  coverImageAlt    String?
  /// Lowercase, de-duplicated labels such as "react" or "nextjs".
  tags             String[]       @default([])
  status           BlogPostStatus @default(draft)
  /// Words divided by 200, rounded up. Recomputed on every save.
  readingMinutes   Int            @default(1)
  /// Replaces the title tag only; the page heading keeps `title`.
  seoTitle         String?
  /// Replaces the excerpt as the meta description.
  seoDescription   String?
  /// Set only when the post first appeared elsewhere (dev.to, Medium).
  canonicalUrl     String?
  /// Set by the first publish and never moved afterwards.
  publishedAt      DateTime?
  /// Last change to the title, excerpt or body after the first publish.
  /// Drives the "Updated" label, article:modified_time and sitemap lastmod,
  /// so republishing alone never looks like a content change.
  contentUpdatedAt DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Who wrote it. Kept when the account is deleted, as an unattributed post.
  authorId String?
  author   AdminUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([categoryId])
}
